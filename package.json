{
  "name": "pure-diagramming",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.1",
    "npm": "11.9.0"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "preinstall": "node scripts/check-toolchain.mjs",
    "dev": "vite --host 127.0.0.1",
    "validate": "node --experimental-strip-types scripts/validate-diagrams.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build": "node scripts/check-toolchain.mjs && npm run validate && npm test && tsc --noEmit && vite build && node scripts/check-artifact.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "html-to-image": "1.11.11",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4"
  }
}
