load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library", "js_run_binary", "js_test")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//:typescript/package_json.bzl", tsc_bin = "bin")
load("@npm//:vite/package_json.bzl", vite_bin = "bin")
load("@npm//:eslint/package_json.bzl", eslint_bin = "bin")
load("@npm//:dependency-cruiser/package_json.bzl", depcruise_bin = "bin")

package(default_visibility = ["//visibility:private"])

npm_link_all_packages(name = "node_modules")

js_library(
    name = "core",
    srcs = [
        "src/editor-state.ts",
        "src/image-bounds.ts",
        "src/model.ts",
        "src/portable.ts",
        "src/view.ts",
    ],
)

js_library(
    name = "browser",
    srcs = [
        "src/App.tsx",
        "src/DiagramCanvas.tsx",
        "src/EditorPanels.tsx",
        "src/export-png.ts",
        "src/useWorkspace.ts",
    ],
    deps = [
        ":core",
        ":node_modules/@xyflow/react",
        ":node_modules/html-to-image",
        ":node_modules/react",
    ],
)

js_library(
    name = "entrypoint",
    srcs = ["src/main.tsx", "src/style.css", "project.json"] + glob(["diagrams/*.json"]),
    deps = [":browser", ":core", ":node_modules/react", ":node_modules/react-dom"],
)

js_library(
    name = "build_config",
    srcs = ["vite.config.ts", "scripts/build-source.ts"],
    deps = [":node_modules/vite", ":node_modules/vite-plugin-singlefile"],
)

# The source identity is an explicit action input, never ambient environment.
js_binary(
    name = "build_site",
    entry_point = "scripts/build-site.mjs",
    data = [":build_config", ":node_modules/vite", "scripts/materialize.ts"],
)

js_run_binary(
    name = "site",
    tool = ":build_site",
    srcs = ["index.html", "package.json", "tsconfig.json", ":entrypoint"],
    env = {"SOURCE_COMMIT": "$(SOURCE_COMMIT)"},
    out_dirs = ["dist"],
)

CHECK_DATA = [":entrypoint", ":build_config", ":node_modules", "package.json", "tsconfig.json"] + glob(["scripts/*", "tests/**"])

tsc_bin.tsc_test(
    name = "typecheck",
    data = CHECK_DATA + ["vitest.config.ts"],
    args = ["--noEmit"],
)

js_test(
    name = "unit_tests",
    entry_point = "scripts/run-check.mjs",
    data = CHECK_DATA + ["vitest.config.ts", "eslint.config.js", "knip.json", "index.html"],
    args = ["vitest", "run"],
    size = "medium",
)

eslint_bin.eslint_test(
    name = "lint",
    data = CHECK_DATA + ["eslint.config.js", "vitest.config.ts"],
    args = ["--max-warnings", "0", "src", "scripts", "tests", "vite.config.ts", "vitest.config.ts", "eslint.config.js"],
)

depcruise_bin.depcruise_test(
    name = "dependency_boundaries",
    data = CHECK_DATA + [".dependency-cruiser.json"],
    args = ["src", "scripts", "tests"],
)

js_test(
    name = "unused_code",
    entry_point = "scripts/run-check.mjs",
    data = CHECK_DATA + ["knip.json", "vitest.config.ts", "eslint.config.js", "index.html"],
    args = ["knip", "--no-progress"],
)

js_test(
    name = "validate_diagrams",
    entry_point = "scripts/validate-diagrams.ts",
    data = [":core"] + glob(["diagrams/*.json"]),
)

js_test(
    name = "artifact_contract",
    entry_point = "scripts/check-artifact.mjs",
    data = [":core", ":site", "scripts/build-source.ts"] + glob(["diagrams/*.json"]),
    env = {"SOURCE_COMMIT": "$(SOURCE_COMMIT)"},
)

vite_bin.vite_binary(
    name = "dev",
    data = [":entrypoint", ":build_config", "index.html", "package.json", "tsconfig.json"],
    args = ["--host", "127.0.0.1"],
    tags = ["manual"],
)

vite_bin.vite_binary(
    name = "preview",
    data = [":site", ":build_config", "package.json"],
    args = ["preview", "--host", "127.0.0.1"],
    tags = ["manual"],
)


js_binary(
    name = "print_node_and_tsdk_paths",
    entry_point = "scripts/print-toolchain.mjs",
    data = [":node_modules/typescript"],
    tags = ["manual"],
)

js_test(
    name = "lockfile_consistency",
    entry_point = "scripts/check-lockfile.mjs",
    data = [
        "@pnpm//:pnpm",
        ".npmrc",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "scripts/materialize.ts",
    ],
    args = ["$(rootpath @pnpm//:pnpm)"],
)
